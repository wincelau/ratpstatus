pactedSections":[{"lineId":"line:IDFM:C01731","from":{"type":"stop_area","id":"stop_area:IDFM:411483","name":"Montargis (Montargis)"},"to":{"type":"stop_area","id":"stop_area:IDFM:61410","name":"Moret - Veneux-les-Sablons (Moret-Loing-et-Orvanne)"}},{"lineId":"line:IDFM:C01731","from":{"type":"stop_area","id":"stop_area:IDFM:61410","name":"Moret - Veneux-les-Sablons (Moret-Loing-et-Orvanne)"},"to":{"type":"stop_area","id":"stop_area:IDFM:411483","name":"Montargis (Montargis)"}}],"disruption_id":"5a309da6-8873-4c92-b119-784a9d4010ac"},{"id":"dbd48f85-607b-456b-a4c6-a09ed94fdb7e","applicationPeriods":[{"begin":"20260904T030000","end":"20260912T030000"}],"lastUpdate":"20260904T140145","cause":"PERTURBATION","severity":"PERTURBEE","title":"Ligne J. L'offre de transport est réduite.","message":"<p>Ligne J. L'offre de transport est adapt&#233;e sur les axes Conflans-Sainte-Honorine et Les Mureaux..<br><br>La plupart des trains dont les roues avaient &#233;t&#233; endommag&#233;es par un incident d'exploitation ont &#233;t&#233; r&#233;par&#233;s. <br><br>Une derni&#232;re cat&#233;gorie de mat&#233;riel n&#233;cessite une maintenance prolong&#233;e dans nos ateliers impactant la desserte des axes Conflans-Sainte-Honorine et Les Mureaux. <br><br> Le plan de transport du 07 au 11 septembre : <br><br>les trains ayant pour origine ou terminus Conflans-Sainte-Honorine et Les Mureaux sont supprim&#233;s.<br><br>Pour compenser la r&#233;duction de desserte, des trains marqueront des arr&#234;ts suppl&#233;mentaires dans certaines gares.<br><br>Les &#233;quipes sont mobilis&#233;es pour un retour &#224; la normale : <br><br>le 11 septembre sur l'axe Les Mureaux;<br><br>au cours de l'automne sur l'axe Conflans-Sainte-Honorine.<br><br>Retrouvez chaque vendredi d&#232;s 17h les horaires des trains qui circuleront la semaine suivante sur la rubrique \"Recherche Itin&#233;raire\". Nous vous recommandons &#233;galement de v&#233;rifier vos horaires avant de vous rendre en gare.<br><br>