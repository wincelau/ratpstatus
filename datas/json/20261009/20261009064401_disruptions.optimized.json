:[{"begin":"20261006T050000","end":"20261011T235900"}],"lastUpdate":"20261008T201714","cause":"PERTURBATION","severity":"BLOQUANTE","title":"Tramway T14 -  Mouvement social du Mardi  6\/10 au dimanche 11\/10.","message":"<p>De mardi 6 au dimanche 11 &nbsp;octobre.&nbsp;<\/p><p>&nbsp;<\/p><p>Trafic interrompu sur la ligne T14.&nbsp;<\/p><p>&nbsp;<\/p><p>Des bus de remplacement sont mis en œuvre. Prévoyez un allongement de temps de parcours. Dans la mesure du possible, nous vous conseillons de limiter vos déplacements.<\/p><p>&nbsp;<\/p><p>Retrouvez toutes ces informations sur l’appli Ile-de-France Mobilités et le site iledefrance-mobilites.fr ou votre appli de mobilité.<\/p><p>&nbsp;<\/p><p>Motif : Mouvement social.<\/p>","disruption_id":"9a7e4cc6-905c-4408-afdb-9f66064be3c2"},{"id":"9bb80841-6d24-4fb9-870b-289d7ed350dc","applicationPeriods":[{"begin":"20261003T233100","end":"20261009T235900"}],"lastUpdate":"20261007T114226","cause":"INFORMATION","severity":"INFORMATION","title":"Sonorisation hors service sur l'ensemble de la ligne T4","message":"<p>La sonorisation est hors service sur l'ensemble de la ligne T4<\/p><p>&nbsp;<\/p><p>Nos équipes de maintenance sont mobilisées afin de rétablir le service dans les meilleurs délais.<\/p><p>&nbsp;<\/p><p>Nous vous prions de bien vouloir nous excuser pour la gêne occasionnée.<\/p><p>&nbsp;<\/p>","disruption_id":"96172fd7-9a66-4dec-bd0b-76b452a5a04e"},{"id":"bab42734-1f4c-4263-9308-c4e42262630c","applicationPeriods":[{"begin":"20261005T030000","end":"20261012T030000"}],"lastUpdate":"20261005T135645","cause":"PERTURBATION","severity":"PERTURBEE","title":"Ligne J. Offre de transport adaptée axe Conflans-Sainte-Honorine.","message":"<p>Ligne J. L'offre de transport est adapt&#233;e sur l'axe Conflans-Sainte-Honorine.<br><br>Certains mat&#233;riels n&#233;cessitent une maintenance prolong&#233;e dans nos ateliers impactant la desserte de l'axe Conflans-Sainte-Honorine.<br><br>Le plan de transport du 05 octobre au 09 octobre :<br><br>les trains ayant pour origine ou terminus Conflans-Sainte-Honorine sont supprim&#233;s.<br><br>Pour compenser la r&#233;duction de desserte, des trains marqueront des arr&#234;ts suppl&#233;mentaires dans certaines gares.<br><br>Les &#233;quipes restent mobilis&#233;es pour un retour &#224; la normale au cours de l'automne pour l'axe Conflans-Sainte-Honorine.<br><br>Retrouvez chaque vendredi d&#232;s 17h les horaires des trains qui circuleront la semaine suivante sur la rubrique \"Recherche Itin&#233;raire\". Nous vous recommandons &#233;galement de v&#233;rifier vos horaires avant de vous rendre en gare.<br><br>Pour plus d&#8217;informations rendez vous sur le Blog Ligne J<\/p>","shortMessage":"Trafic perturbé","disruption_id":"0f3cd7be-8807-490d-84dd-a6bb1b04d08b"},{"id":"2693fdf2-3b2f-4eed-9634-777da02d5e4c","applicationPeriods":[{"begin":"20261005T040000","end":"20261009T235900"}],"lastUpdate":"20261005T131417","cause":"PERTURBATION","severity":"PERTURBEE","title":"Tramway T4 -  Mouvement social du 5\/10 au 9\/10.","message":"<p>Du lundi 5 au vendredi 9 octobre le trafic est perturbé sur la ligne T4.&nbsp;<\/p><p>&nbsp;<\/p><p>Prévoir 1 train toutes les 9 minutes 30. Dans la mesure du possible, nous vous conseillons de limiter vos déplacements.<\/p><p>&nbsp;<\/p><p>Retrouvez toutes ces informations sur l'appli Ile-de-France Mobilites, le site Iledefrance-mobilites.fr ou votre appli de mobilité.<br>&nbsp;<\/p><p>Motif : Mouvement Social.<br>&nbsp;<\/p>","disruption_id":"3ae895f2-12de-491b-ac96-da94bb5e9b28"},{"id":"e79f7fff-2c35-4afa-82a8-fdc03b6e85c4","applicationPeriods":[{"begin":"20260629T161600","end":"20281231T200000"}],"lastUpdate":"20260831T153045","cause":"PERTURBATION","severity":"PERTURBEE","title":"Travaux","message":"<p>L'arrêt Capitaine Glarner est non desservi<\/p>"}],"lines":[{"id":"line:IDFM:C01372","name":"2","shortName":"2","mode":"Metro","networkId":"network:IDFM:Operator_100","impactedObjects":[]},{"id":"line:IDFM:C01374","name":"4","sho