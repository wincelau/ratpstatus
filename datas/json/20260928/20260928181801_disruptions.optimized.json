ion_id":"9753ce00-dac8-47af-a2e3-856f0d3b2325"},{"id":"f5e8aca6-6ebf-4575-a463-7f86dde34fe3","applicationPeriods":[{"begin":"20260928T030000","end":"20261003T030000"}],"lastUpdate":"20260925T085946","cause":"PERTURBATION","severity":"PERTURBEE","title":"Ligne J. L'offre de transport est adaptée sur l'axe Conflans.","message":"<p>Ligne J. L'offre de transport est adapt&#233;e sur l'axe Conflans-Sainte-Honorine.<br><br>Certains mat&#233;riels n&#233;cessitent une maintenance prolong&#233;e dans nos ateliers impactant la desserte de l'axe Conflans-Sainte-Honorine. <br><br> Le plan de transport du 28 septembre au 02 octobre  : <br><br>    les trains ayant pour origine ou terminus Conflans-Sainte-Honorine sont supprim&#233;s.<br><br>Pour compenser la r&#233;duction de desserte, des trains marqueront des arr&#234;ts suppl&#233;mentaires dans certaines gares.<br><br>Les &#233;quipes restent mobilis&#233;es pour un retour &#224; la normale au cours de l'automne pour l'axe Conflans-Sainte-Honorine.<br><br>Retrouvez chaque vendredi d&#232;s 17h les horaires des trains qui circuleront la semaine suivante sur la rubrique \"Recherche Itin&#233;raire\". Nous vous recommandons &#233;galement de v&#233;rifier vos horaires avant de vous rendre en gare.<br><br>Pour plus d&#8217;informations rendez vous sur le <a href=\"https:\/\/malignej.transilien.com\/2026\/08\/28\/ligne-j-point-de-situation-sur-le-plan-de-transport-de-rentree\/\">Blog Ligne J<\/a><\/p>","shortMessage":"Trafic perturbé","disruption_id":"2c4a9646-1462-4037-9538-57a5a9446152"},{"id":"1e1ebf98-31cb-4e1b-96ab-f26aba8e71c2","applicationPeriods":[{"begin":"20260928T030000","end":"20260929T030000"}],"lastUpdate":"20260914T111642","cause":"TRAVAUX","severity":"PERTURBEE","title":"Ligne R : modification des horaires des trains du 07\/09 au 30\/09","message":"<p>P&#233;riode : Du lundi au dimanche<br><br>Dates : du 07\/09 au 30\/09<br><br>Les horaires de d&#233;part ou de passage en gare de certains trains de la ligne R peuvent &#234;tre avanc&#233;s et vos temps de trajet peuvent &#234;tre impact&#233;s.<br><br>Les horaires du calculateur d'itin&#233;raire tiennent compte des travaux.<br><br>Motif : travaux de maintenance et de cr&#233;ation du r&#233;seau<br><br>Retrouvez toutes les informations sur <a href=\"https:\/\/x.com\/LIGNER_SNCF\">le fil X<\/a> ou le blog de votre ligne.<\/p>","shortMessage":"Trafic perturbé","disruption_id":"b419a6da-4a7d-4537-9c01-ded5af985b06"},{"id":"522e40c2-db00-47c6-9984-b71c26e1ff06","applicationPeriods":[{"begin":"20260914T082000","end":"20260930T000100"}],"lastUpdate":"20260908T154136","cause":"INFORMATION","severity":"INFORMATION","tags":["Actualité"],"title":"Renforcement de l'offre - Tramway T9","message":"<p><strong><u>Renforcement de l'offre &nbsp;- Tramway T9<\/u><\/strong><\/p><p><i>A compter du 17 août 2026&nbsp;<\/i><\/p><p>Du lundi au vendredi :<\/p><ul><li>Un tramway<u> toutes les 8 minutes entre 6h et 7h,<\/u><\/li><li>Un tramway <u>toutes les 4 minutes entre 16h30 et 20h00.<\/u><\/li><\/ul><p>&nbsp;<\/p><p>Plus d'informations sur le site Île-de-France Mobilités.&nbsp;<\/p>","disruption_id":"c442665d-bb70-4d7e-bed6-9d232aefcb35"},{"id":"32499096-88e6-48f0-82cf-da88633d93e0","applicationPeriods":[{"begin":"20260928T175600","end":"20260928T200000"}],"lastUpdate":"20260928T180443","cause":"INFORMATION","severity":"INFORMATION","title":"Ligne R : Paris Gare de Lyon - Montereau forte affluence","message":"<p>Le train suivant circule avec 2 &#233;l&#232;ments au lieu de 3 &#233;l&#233;ments.<\/p><p>Risque de forte affluence &#224; bord du train :<\/p><p>- KUMO, d&#233;part Paris Gare de Lyon 18h45, passage Moret-Veneux-les-Sablons 19h33, arriv&#233;e Montereau 19h44.<br><br><br><br>Motif : train court (retenu en atelier de maintenance)<\/p>","impactedSections":[{"lineId":"line:IDFM:C01731","from":{"type":"stop_area","id":"stop_area:IDFM:73626","name":"Gare de Lyon (Paris)"},"to":{"type":"stop_area","id":"stop_area:IDFM:61414","name":"Monterea